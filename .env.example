# Vorlage für lokale Umgebungsvariablen.
# Verwendung: cp .env.example .env  (die echte .env ist gitignored)
# Werte in Produktion ausschließlich über GitHub Secrets / Secret-Store setzen.

# --- PostgreSQL (docker-compose.yml, docker-compose.prod.yml) ---
POSTGRES_DB=jorchos_db
POSTGRES_USER=jorchos_user
POSTGRES_PASSWORD=change-me

# Hibernate DDL-Modus: Flyway verwaltet das Schema, daher "validate" beibehalten.
SPRING_JPA_DDL_AUTO=validate

# --- JWT (backend/src/main/resources/application.properties) ---
# Base64-kodiertes Secret, mindestens 32 Byte (JJWT HMAC-Schlüssel).
# Für lokale Entwicklung ausreichend, in Produktion zwingend ersetzen.
JWT_SECRET_KEY=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# --- Nur Produktion (docker-compose.prod.yml) ---
# GitHub-Repository im Format owner/repo für die GHCR-Images.
GITHUB_REPOSITORY=owner/repo
# UID des Host-Users, unter dem Promtail das Journal liest (id -u).
PODMAN_UID=1000
